{
  "name": "creatorize-suite",
  "version": "0.3.2",
  "private": true,
  "description": "Local AI video production, editing and rendering studio",
  "author": "Creatorize Suite",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node server/index.mjs",
    "build": "node scripts/prepare-player.mjs && next build --webpack",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test:desktop": "node tests/desktop.mjs",
    "test:media": "node tests/media.mjs",
    "test:provider": "node tests/provider.mjs",
    "package": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "adm-zip": "^0.6.1",
    "cron-parser": "^5.10.2",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.11.2",
    "multer": "^2.0.2",
    "playwright": "^1.64.0",
    "pngjs": "^7.0.0",
    "sql.js": "^1.13.0",
    "three": "^0.180.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@xyflow/react": "^12.10.0",
    "lucide-react": "^0.468.0",
    "next": "^16.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.12",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^6.3.0"
  },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "studio.framecraft.desktop",
    "productName": "Creatorize Suite",
    "directories": {
      "output": "release/v0.3.2"
    },
    "files": [
      "out/**/*",
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/**/*",
      "public/lib/styles.js",
      "public/lib/quality.js",
      "public/lib/workflow.js",
      "server/**/*"
    ],
    "win": {
      "icon": "public/icon.ico",
      "target": "portable",
      "signExecutable": false
    },
    "extraResources": [
      {
        "from": "resources/models",
        "to": "models"
      },
      {
        "from": "resources/ffmpeg",
        "to": "ffmpeg"
      },
      {
        "from": "resources/browser",
        "to": "browser"
      },
      {
        "from": "resources/licenses",
        "to": "licenses"
      }
    ]
  }
}
